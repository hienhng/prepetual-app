# Database
DATABASE_URL=postgresql://user:password@localhost:5432/prepetual

# Session Security
SESSION_SECRET=your_super_secret_random_string

# AI Integrations (OpenAI)
AI_INTEGRATIONS_OPENAI_API_KEY=sk-xxxx
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_QUIZ_MODEL=llama-3.3-70b-versatile
# Optional: use a stronger reasoning model for solving and the independent answer audit.
# Falls back to AI_QUIZ_MODEL when omitted.
AI_VALIDATION_MODEL=
AI_VISION_MODEL=qwen/qwen3.6-27b
# Maximum total time for AI image transcription before basic OCR takes over
AI_VISION_TEXT_TIMEOUT_MS=30000

# Google Auth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email (Nodemailer)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-specific-password

# YouTube API (Optional if using other methods)
YOUTUBE_TRANSCRIPT_API_KEY=your-api-key

# Supadata free tier: https://dash.supadata.ai
SUPADATA_API_KEY=your-supadata-api-key
