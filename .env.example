# Database
DATABASE_URL=postgresql://user:password@localhost:5432/prepetual

# Session Security
SESSION_SECRET=your_super_secret_random_string
# Canonical public origin used in password-reset links. HTTPS is required in production.
APP_URL=https://prepetual.app

# Shared PostgreSQL-backed authentication and email-abuse limits.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_EMAIL_RATE_LIMIT_WINDOW_MS=3600000
AUTH_REGISTER_RATE_LIMIT=5
AUTH_LOGIN_IP_RATE_LIMIT=30
AUTH_LOGIN_ACCOUNT_RATE_LIMIT=10
AUTH_VERIFY_RATE_LIMIT=10
AUTH_FORGOT_IP_RATE_LIMIT=10
AUTH_FORGOT_ACCOUNT_RATE_LIMIT=3
AUTH_RESET_IP_RATE_LIMIT=10
AUTH_RESET_TOKEN_RATE_LIMIT=5
AUTH_GOOGLE_RATE_LIMIT=30
AUTH_RESEND_IP_RATE_LIMIT=10
AUTH_RESEND_ACCOUNT_RATE_LIMIT=3
CONTACT_RATE_LIMIT=5

# AI Integrations (Groq through its OpenAI-compatible API)
AI_INTEGRATIONS_OPENAI_API_KEY=gsk_xxxx
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.groq.com/openai/v1
AI_QUIZ_MODEL=openai/gpt-oss-120b
# Optional: use a stronger reasoning model for solving and the independent answer audit.
# Falls back to AI_QUIZ_MODEL when omitted.
AI_VALIDATION_MODEL=
AI_VISION_MODEL=qwen/qwen3.8-27b
# Maximum total time for AI image transcription before basic OCR takes over
AI_VISION_TEXT_TIMEOUT_MS=30000

# Shared PostgreSQL-backed provider abuse limits. Each limit applies per user
# (or per IP for guest-accessible AI features) within the configured window.
PROVIDER_RATE_LIMIT_WINDOW_MS=600000
SOURCE_PROCESSING_RATE_LIMIT=12
AI_GENERATION_RATE_LIMIT=6
AI_SUMMARY_RATE_LIMIT=12
QUIZ_SUBMISSION_RATE_LIMIT=6
INTERACTIVE_AI_RATE_LIMIT=60

# Dense retrieval embeddings (Groq does not currently provide an embeddings API).
# Use an embeddings provider with an OpenAI-compatible endpoint. The schema is
# fixed at 1536 dimensions, matching text-embedding-3-small below.
AI_EMBEDDING_API_KEY=sk_xxxx
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_MODEL=text-embedding-3-small

# Google Auth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email (Nodemailer)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-specific-password

# YouTube API (Optional if using other methods)
YOUTUBE_TRANSCRIPT_API_KEY=your-api-key

# Supadata free tier: https://dash.supadata.ai
SUPADATA_API_KEY=your-supadata-api-key

# Parallel quiz audit batches (1-4); reduce if the provider rate-limits requests.
QUIZ_VALIDATION_CONCURRENCY=4
